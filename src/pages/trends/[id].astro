import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import LabDiagram from '../../components/LabDiagram.astro';
import { withBase } from '../../utils/paths';

export async function getStaticPaths() {
  const trends = await getCollection('trends');
  return trends.map((post) => ({
    params: { id: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<BaseLayout title={`${post.data.title} · Google Cloud Labs`} description={post.data.subtitle}>
  <article class="max-w-4xl mx-auto">
    <a href={withBase('/trends')} class="lab-mono text-xs underline inline-block mb-5" style="color: var(--accent-primary);">
      ← Back to Trends &amp; Field Notes
    </a>

    <header class="lab-card p-6 sm:p-8">
      <div class="flex flex-wrap items-center gap-3 text-xs lab-mono" style="color: var(--fg-muted);">
        <span class="lab-pill">{post.data.category}</span>
        <span>{post.data.publishedDate}</span>
        <span>·</span>
        <span>{post.data.readTime}</span>
      </div>

      <h1 class="text-2xl sm:text-4xl font-extrabold tracking-tight mt-4 leading-tight">
        {post.data.title}
      </h1>

      <p class="text-base sm:text-lg mt-3 leading-relaxed" style="color: var(--fg-secondary);">
        {post.data.subtitle}
      </p>

      <div class="mt-4 pt-4 flex flex-wrap items-center justify-between gap-3 text-xs lab-mono" style="border-top: 1px solid var(--border-subtle); color: var(--fg-muted);">
        <span>Authors: {post.data.authors.join(', ')}</span>
        {post.data.externalPaperUrl && (
          <a
            href={post.data.externalPaperUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="underline"
            style="color: var(--accent-primary);"
          >
            Read Preprint on arXiv ↗
          </a>
        )}
      </div>
    </header>

    <div class="mt-6">
      <LabDiagram kind={post.data.diagramKind} caption={post.data.keyTakeaway} />
    </div>

    <div class="lab-card p-6 sm:p-8 mt-6 space-y-4 text-sm sm:text-base leading-relaxed" style="color: var(--fg-secondary);">
      <Content />
    </div>
  </article>
</BaseLayout>
