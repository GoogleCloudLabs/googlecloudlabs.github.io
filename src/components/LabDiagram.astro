interface Props {
  kind: 'policing-flow' | 'gemma-order-chart' | 'factory-regimes';
  caption?: string;
}

const { kind, caption } = Astro.props;
---

<figure
  class="rounded-xl p-4 sm:p-5 overflow-hidden"
  style="background: var(--pele-bg); border: 1px solid var(--pele-border);"
>
  {kind === 'policing-flow' && (
    <svg viewBox="0 0 760 210" class="w-full h-auto block" role="img" aria-label="Cross-family multi-model policing architecture diagram">
      <defs>
        <marker id="arrow-pele" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
          <path d="M 0 1 L 10 5 L 0 9 z" fill="var(--pele-line)" />
        </marker>
      </defs>
      <rect x="16" y="68" width="146" height="74" rx="8" fill="var(--pele-surface)" stroke="var(--pele-border)" stroke-width="1.5" />
      <text x="89" y="99" text-anchor="middle" fill="var(--pele-accent)" font-size="11" font-family="monospace" font-weight="700">INBOUND BID</text>
      <text x="89" y="120" text-anchor="middle" fill="var(--pele-fg)" font-size="13" font-weight="600">Market Proposal</text>

      <line x1="162" y1="105" x2="218" y2="105" stroke="var(--pele-line)" stroke-width="1.8" marker-end="url(#arrow-pele)" />

      <rect x="222" y="56" width="176" height="98" rx="8" fill="var(--pele-surface-alt)" stroke="var(--pele-accent)" stroke-width="1.8" />
      <text x="310" y="84" text-anchor="middle" fill="var(--pele-accent)" font-size="11" font-family="monospace" font-weight="700">LEAD AGENT (FAMILY A)</text>
      <text x="310" y="107" text-anchor="middle" fill="var(--pele-fg)" font-size="13" font-weight="700">Policy &amp; Margin Check</text>
      <text x="310" y="129" text-anchor="middle" fill="var(--pele-muted)" font-size="11">Fast structural triage</text>

      <line x1="398" y1="105" x2="454" y2="105" stroke="var(--pele-line)" stroke-width="1.8" marker-end="url(#arrow-pele)" />

      <rect x="458" y="56" width="176" height="98" rx="8" fill="var(--pele-surface-alt)" stroke="var(--pele-series-2)" stroke-width="1.8" />
      <text x="546" y="84" text-anchor="middle" fill="var(--pele-series-2)" font-size="11" font-family="monospace" font-weight="700">AUDITOR (FAMILY B)</text>
      <text x="546" y="107" text-anchor="middle" fill="var(--pele-fg)" font-size="13" font-weight="700">Adversarial Probe</text>
      <text x="546" y="129" text-anchor="middle" fill="var(--pele-muted)" font-size="11">77.4% attacks blocked</text>

      <line x1="634" y1="86" x2="672" y2="56" stroke="var(--pele-series-2)" stroke-width="1.8" marker-end="url(#arrow-pele)" />
      <line x1="634" y1="124" x2="672" y2="154" stroke="var(--pele-series-3)" stroke-width="1.8" marker-end="url(#arrow-pele)" />

      <rect x="676" y="28" width="68" height="48" rx="6" fill="var(--pele-surface)" stroke="var(--pele-series-2)" stroke-width="1.5" />
      <text x="710" y="50" text-anchor="middle" fill="var(--pele-series-2)" font-size="11" font-family="monospace" font-weight="700">SETTLE</text>
      <text x="710" y="65" text-anchor="middle" fill="var(--pele-fg)" font-size="10">81.6%</text>

      <rect x="676" y="134" width="68" height="48" rx="6" fill="var(--pele-surface)" stroke="var(--pele-series-3)" stroke-width="1.5" />
      <text x="710" y="156" text-anchor="middle" fill="var(--pele-series-3)" font-size="11" font-family="monospace" font-weight="700">BLOCK</text>
      <text x="710" y="171" text-anchor="middle" fill="var(--pele-fg)" font-size="10">77.4%</text>
    </svg>
  )}

  {kind === 'gemma-order-chart' && (
    <svg viewBox="0 0 760 205" class="w-full h-auto block" role="img" aria-label="Gemma 4 semantic framing vs presentation order effect chart">
      <text x="20" y="28" fill="var(--pele-muted)" font-size="11" font-family="monospace">LOG-LIKELIHOOD SHIFT MAGNITUDE (NATS · N = 784 FORWARD PASSES)</text>
      <rect x="20" y="48" width="210" height="36" rx="4" fill="var(--pele-surface)" />
      <text x="28" y="70" fill="var(--pele-fg)" font-size="12" font-weight="600">Semantic Source Framing</text>
      <rect x="242" y="52" width="410" height="28" rx="5" fill="var(--pele-accent)" opacity="0.9" />
      <text x="662" y="71" fill="var(--pele-accent)" font-size="13" font-family="monospace" font-weight="700">+1.054 nats (~4.0x)</text>

      <rect x="20" y="98" width="210" height="36" rx="4" fill="var(--pele-surface)" />
      <text x="28" y="120" fill="var(--pele-fg)" font-size="12" font-weight="600">Item-by-Item Margin</text>
      <rect x="242" y="102" width="301" height="28" rx="5" fill="var(--pele-series-2)" opacity="0.9" />
      <text x="553" y="121" fill="var(--pele-series-2)" font-size="13" font-family="monospace" font-weight="700">+0.774 nats</text>

      <rect x="20" y="148" width="210" height="36" rx="4" fill="var(--pele-surface)" />
      <text x="28" y="170" fill="var(--pele-fg)" font-size="12" font-weight="600">Prompt Order Baseline</text>
      <rect x="242" y="152" width="103" height="28" rx="5" fill="var(--pele-series-3)" opacity="0.9" />
      <text x="355" y="171" fill="var(--pele-series-3)" font-size="13" font-family="monospace" font-weight="700">-0.265 nats (1.0x)</text>
    </svg>
  )}

  {kind === 'factory-regimes' && (
    <svg viewBox="0 0 760 195" class="w-full h-auto block" role="img" aria-label="Agent factory orchestration and verification architecture">
      <rect x="18" y="34" width="218" height="128" rx="8" fill="var(--pele-surface)" stroke="var(--pele-border)" stroke-width="1.5" />
      <text x="34" y="62" fill="var(--pele-accent)" font-size="11" font-family="monospace" font-weight="700">01 · EPHEMERAL WORKERS</text>
      <text x="34" y="88" fill="var(--pele-fg)" font-size="13" font-weight="700">Scoped Task Slates</text>
      <text x="34" y="112" fill="var(--pele-muted)" font-size="11.5">Clean per-ticket context</text>
      <text x="34" y="132" fill="var(--pele-muted)" font-size="11.5">prevents spec drift</text>

      <rect x="271" y="34" width="218" height="128" rx="8" fill="var(--pele-surface-alt)" stroke="var(--pele-accent)" stroke-width="1.8" />
      <text x="287" y="62" fill="var(--pele-accent)" font-size="11" font-family="monospace" font-weight="700">02 · AST MERKLE-DAG</text>
      <text x="287" y="88" fill="var(--pele-fg)" font-size="13" font-weight="700">Symbol-Level Merges</text>
      <text x="287" y="112" fill="var(--pele-muted)" font-size="11.5">Eliminates single-file</text>
      <text x="287" y="132" fill="var(--pele-muted)" font-size="11.5">git coordinator stalls</text>

      <rect x="524" y="34" width="218" height="128" rx="8" fill="var(--pele-surface)" stroke="var(--pele-series-2)" stroke-width="1.8" />
      <text x="540" y="62" fill="var(--pele-series-2)" font-size="11" font-family="monospace" font-weight="700">03 · POST-HOC HARNESS</text>
      <text x="540" y="88" fill="var(--pele-fg)" font-size="13" font-weight="700">Independent Verifier</text>
      <text x="540" y="112" fill="var(--pele-muted)" font-size="11.5">Blocks false self-reported</text>
      <text x="540" y="132" fill="var(--pele-muted)" font-size="11.5">green integration runs</text>
    </svg>
  )}

  {caption && (
    <figcaption class="mt-2.5 text-xs lab-mono flex items-center justify-between gap-3" style="color: var(--pele-muted);">
      <span>{caption}</span>
      <span class="shrink-0 whitespace-nowrap opacity-80">SVG · --pele-*</span>
    </figcaption>
  )}
</figure>
